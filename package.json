{
  "name": "@rljson/network",
  "version": "0.0.21",
  "description": "Networking middle layer providing basic advertising and discovery as well as cloud fall backs and basic config.",
  "homepage": "https://github.com/rljson/network",
  "bugs": "https://github.com/rljson/network/issues",
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22.14.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rljson/network.git"
  },
  "main": "dist/network.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "type": "module",
  "scripts": {
    "build": "pnpm exec vite build && tsc && node scripts/copy-readme-to-dist.js",
    "test": "pnpm exec vitest run --coverage && pnpm run lint",
    "prebuild": "npm run test",
    "prepublishOnly": "npm run build",
    "lint": "pnpm exec eslint",
    "updateGoldens": "cross-env UPDATE_GOLDENS=true pnpm test"
  },
  "devDependencies": {
    "@rljson/dna-rljson": "^0.2.0",
    "@tssuite/helix-js": "^0.3.0",
    "@types/node": "^24.13.5",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "@vitest/coverage-v8": "^5.0.1",
    "cross-env": "^10.1.0",
    "eslint": "~10.10.0",
    "eslint-plugin-jsdoc": "^64.5.0",
    "eslint-plugin-tsdoc": "^0.5.3",
    "globals": "^17.12.0",
    "jsdoc": "^4.0.5",
    "read-pkg": "^10.1.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vite-node": "^6.0.0",
    "vite-plugin-dts": "^5.1.0",
    "vitest": "^5.0.1",
    "vitest-dom": "^0.1.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ],
    "overrides": {
      "eslint-plugin-tsdoc>@typescript-eslint/utils": "^8.70.0"
    }
  },
  "packageManager": "pnpm@10.11.0"
}
